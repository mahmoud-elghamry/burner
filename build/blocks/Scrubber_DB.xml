    <Member Name="T_DrnMax" Datatype="TON_TIME" Remanence="NonRetain" Accessibility="Public"><Comment><MultiLanguageText Lang="en-US">Drain open time, 10 min limit (C04a)</MultiLanguageText></Comment></Member>
