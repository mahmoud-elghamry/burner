    <Member Name="PSH" Datatype="Bool" Remanence="NonRetain" Accessibility="Public"><Comment><MultiLanguageText Lang="en-US">PSH-101 healthy: 1 = contact closed (normal pressure)</MultiLanguageText></Comment></Member>
    <Member Name="LSH" Datatype="Bool" Remanence="NonRetain" Accessibility="Public"><Comment><MultiLanguageText Lang="en-US">LSH-102 healthy: 1 = level below high</MultiLanguageText></Comment></Member>
